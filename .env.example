# Copy to .env and fill in. Never commit .env.
# Required only for the Anthropic provider. The mock provider needs nothing.
ANTHROPIC_API_KEY=
# Optional: default Anthropic model (default: claude-opus-5-5)
EVALSPRINT_ANTHROPIC_MODEL=
# Optional: web server bind address and port (defaults: 127.0.0.1 and 5050)
HOST=
PORT=
