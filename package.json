{
  "name": "evalsprint",
  "version": "0.1.0",
  "description": "Regression testing and evaluation toolkit for LLM prompts: test suites, deterministic assertions, prompt comparison, mock and Anthropic providers.",
  "license": "MIT",
  "homepage": "https://pitchvio.info",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bhargavthaparbusiness/evalsprint.git"
  },
  "bugs": {
    "url": "https://github.com/bhargavthaparbusiness/evalsprint/issues",
    "email": "contact@pitchvio.info"
  },
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "bin": {
    "evalsprint": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "examples"
  ],
  "scripts": {
    "dev": "tsx watch --clear-screen=false --ignore 'src/web/**' src/server/index.ts",
    "build": "npm run build:node && npm run build:web",
    "build:node": "tsc -p tsconfig.node.json",
    "build:web": "vite build",
    "start": "node dist/server/index.js",
    "evalsprint": "tsx src/cli/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.web.json",
    "lint": "eslint .",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
